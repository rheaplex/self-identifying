%!PS

/pagewidth 1548 def
/pageheight 1224 def
<< /PageSize [pagewidth pageheight]
>> setpagedevice
/margin 72 def
/fontsize 16 def
/Helvetica fontsize selectfont

/display {
    /texty exch def
    /textx exch def
    /infile exch (r) file def
    newpath
    {
        /line 200 string def
        infile line readline
        {
            textx texty moveto
            line show
            /texty texty fontsize sub def
        } {
            exit
        } ifelse
    } loop
} def

gsave
<< /PatternType 1
   /PaintType 1
   /TilingType 1
   /BBox [0 0 500 500]
   /XStep 183.35 /YStep 181.5
   /PaintProc {
       pop
       50 50 50 0 360 arc
       fill
   } bind
>>
margin margin 2 mul matrix translate
makepattern setpattern
margin
margin 2 mul
pagewidth 0.75 mul margin 2 mul sub
pageheight margin 3 mul sub
rectfill
grestore

(%pipe%sha256sum spots.ps | \
 cut -c-64 | ecdsakeygen -p | \
 ecdsasign spots.ps | \
 xxd -r -p | base64 -w 100)
margin margin display

(spots.ps)
pagewidth 0.75 mul
pageheight margin sub
fontsize 0.7 mul sub
0.955 sub
display

showpage
