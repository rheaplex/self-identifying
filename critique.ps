%!PS

% ledger
/pagewidth 17 72 mul def
/pageheight 11 72 mul def
/margin 72 def
/bigfontsize pageheight margin 3 mul sub 9 div def

/display {
    /texty exch def
    /textx exch def
    /infile exch (r) file def
    /fontsize 10 def
    /Helvetica fontsize selectfont
    newpath
    {
        /line 200 string def
        infile line readline
        {
            textx texty moveto
            line show
            /texty texty fontsize sub def
        } {
            exit
        } ifelse
    } loop
} def

/bigdisplay
{
    % Allow for ascender height on first row
    0.28 sub bigfontsize mul
    margin add
    pageheight exch sub
    margin exch moveto
    show
} def

/Times-Roman bigfontsize selectfont
(This show represents) 1 bigdisplay
(a striking new direction) 2 bigdisplay
(for post-contemporary art) 3 bigdisplay
(against the backdrop) 4 bigdisplay
(of a rudderless wider) 5 bigdisplay
(culture despite its weaving) 6 bigdisplay
(in of the exhausted and) 7 bigdisplay
(increasingly toxic materials) 8 bigdisplay
(of that very culture.) 9 bigdisplay

(%pipe%sha256sum critique.ps | cut -c-64 | \
 ecdsakeygen -p | ecdsasign critique.ps)
margin margin display

(critique.ps)
pagewidth 0.75 mul
pageheight margin sub fontsize sub
display

showpage

