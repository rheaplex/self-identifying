%!PS

% ledger
/pagewidth 17 72 mul def
/pageheight 11 72 mul def
/margin 72 def

/fontsize 8 def
/textx pagewidth 2 div margin add def

/triangleheight pageheight margin 2 mul sub def
/trianglewidth pagewidth 2 div margin 2 mul sub def

/textstart pageheight margin sub fontsize sub def

/randomize {
    100 div
    rand 99 mod 1 add
    mul cvi
} def

seed srand

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% The triangle
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

newpath

trianglewidth randomize margin add
triangleheight randomize margin add
moveto

trianglewidth randomize margin add
triangleheight randomize margin add
lineto

trianglewidth randomize margin add
triangleheight randomize margin add
lineto

closepath
stroke

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% The signature text
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

newpath
/Courier fontsize selectfont
/texty textstart def
/infile
(%pipe%cat inline-hash.ps \
&& echo -n '% ' \
&& sha256sum inline-hash.ps)
(r) file def
{
    % Longer than 80 columns
    /line 96 string def
    infile line readline
    {
        textx texty moveto
        line show
        /texty texty fontsize sub def
    } {
        exit
    } ifelse
} loop

showpage

