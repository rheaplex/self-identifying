%!PS

/pagewidth 1548 def
/pageheight 1224 def
<< /PageSize [pagewidth pageheight]
>> setpagedevice
/margin 72 def
/fontsize 16 def
/bigfontsize pageheight margin 3
mul sub 4 div def

/display {
    /texty exch def
    /textx exch def
    /infile exch (r) file def
    newpath
    {
        /line 200 string def
        infile line readline
        {
            textx texty moveto
            line show
            /texty texty fontsize sub def
        } {
            exit
        } ifelse
    } loop
} def

/bigdisplay
{
    0.275 sub bigfontsize mul
    margin add pageheight exch sub
    margin exch moveto
    show
} def

/Helvetica-Bold bigfontsize selectfont
(I hereby) 1 bigdisplay
(state the) 2 bigdisplay
(fact that) 3 bigdisplay
(I am art) 4 bigdisplay

/Helvetica fontsize selectfont
(%pipe%sha256sum assertion.ps | \
 cut -c-64 | ecdsakeygen -p | \
 ecdsasign assertion.ps | \
 xxd -r -p | base64 -w 100)
margin margin display

(assertion.ps)
pagewidth 0.75 mul
pageheight margin sub
fontsize 0.7 mul sub
0.73 sub
display

showpage
