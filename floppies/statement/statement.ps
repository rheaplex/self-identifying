%!PS

/pagewidth 1548 def
/pageheight 1224 def
<< /PageSize [pagewidth pageheight]
>> setpagedevice
/margin 72 def
/fontsize 16 def
/bigfontsize pageheight margin 3
mul sub 4.74 div def

/display {
    /texty exch def
    /textx exch def
    /infile exch (r) file def
    newpath
    {
        /line 200 string def
        infile line readline
        {
            textx texty moveto
            line show
            /texty texty fontsize sub def
        } {
            exit
        } ifelse
    } loop
} def

/bigdisplay
{
    0.275 sub bigfontsize mul
    margin add pageheight exch sub
    margin exch moveto
    gsave
    1.275 1 scale
    show
    grestore
} def

/Helvetica-Bold bigfontsize selectfont
(TRANS) 1 bigdisplay
(RIGHTS) 2 bigdisplay
(ARE) 3 bigdisplay
(HUMAN) 4 bigdisplay
(RIGHTS) 5 bigdisplay

/Helvetica fontsize selectfont

(%pipe%sha256sum statement.ps | \
 cut -c-64 | ecdsakeygen -p | \
 ecdsasign statement.ps | \
 xxd -r -p | base64 -w 100)
margin margin display

(statement.ps)
pagewidth 0.75 mul
pageheight margin sub
fontsize 0.7 mul sub
display

showpage
