%!PS

/pagewidth 1548 def
/pageheight 1224 def
<< /PageSize [pagewidth pageheight]
>> setpagedevice
/margin 72 def
/fontsize 18 def
/Helvetica fontsize selectfont

/display {
    /texty exch def
    /textx exch def
    /infile exch (r) file def
    newpath
    {
        /line 200 string def
        infile line readline
        {
            textx texty moveto
            line show
            /texty texty fontsize sub def
        } {
            exit
        } ifelse
    } loop
} def

0 0 1 0 setcmykcolor
margin
margin 2 mul
pageheight margin 3 mul sub
dup
rectfill

0 0 0 1 setcmykcolor

(%pipe%sha256sum yellow.ps | \
 cut -c-64 | ecdsakeygen -p | \
 ecdsasign square.ps | \
 xxd -r -p | base64 -w 100)
margin margin display

(yellow.ps)
pagewidth 0.75 mul
pageheight margin sub
fontsize 0.7 mul sub
0.51024 sub
display

showpage
